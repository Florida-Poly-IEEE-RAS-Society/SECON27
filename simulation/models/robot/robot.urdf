<?xml version="1.0"?>
<!--
  Differential drive race robot with a Luxonis OAK-D Lite on a rear mast,
  facing forward.
  Fits the 12 x 12 x 12 in (0.3048 m) start cube.
  Frames: base_link sits at wheel axle height.
-->
<robot name="race_robot">

  <!-- ===== Materials ===== -->
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
  <material name="glass"><color rgba="0.1 0.15 0.2 1"/></material>
  <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="headlight"><color rgba="1.0 0.9 0.4 1"/></material>
  <material name="taillight"><color rgba="0.45 0.0 0.0 1"/></material>

  <!-- ===== Chassis ===== -->
  <!-- Stock-car styling: visuals only. Collision + inertia below are unchanged. -->
  <link name="base_link">
    <!-- Lower body -->
    <visual>
      <origin xyz="0 0 0.0175"/>
      <geometry><box size="0.23 0.19 0.045"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Hood (slopes down toward nose) -->
    <visual>
      <origin xyz="0.072 0 0.045" rpy="0 0.12 0"/>
      <geometry><box size="0.085 0.19 0.01"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Greenhouse, windshield, rear window, roof -->
    <visual>
      <origin xyz="-0.03 0 0.0615"/>
      <geometry><box size="0.09 0.15 0.043"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0.0075 0 0.0675" rpy="0 0.66 0"/>
      <geometry><box size="0.057 0.15 0.006"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="-0.09 0 0.0675" rpy="0 -0.86 0"/>
      <geometry><box size="0.046 0.15 0.006"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 0.086"/>
      <geometry><box size="0.07 0.15 0.006"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Racing stripes (hood, roof) -->
    <visual>
      <origin xyz="0.072 0 0.0505" rpy="0 0.12 0"/>
      <geometry><box size="0.085 0.03 0.002"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 0.0895"/>
      <geometry><box size="0.07 0.03 0.002"/></geometry>
      <material name="white"/>
    </visual>
    <!-- Front splitter, side skirts -->
    <visual>
      <origin xyz="0.12 0 -0.003"/>
      <geometry><box size="0.03 0.2 0.004"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0 0.097 0.002"/>
      <geometry><box size="0.12 0.004 0.012"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.097 0.002"/>
      <geometry><box size="0.12 0.004 0.012"/></geometry>
      <material name="black"/>
    </visual>
    <!-- Rear spoiler (low, deck mounted) -->
    <visual>
      <origin xyz="-0.108 0.07 0.052"/>
      <geometry><box size="0.008 0.008 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.108 -0.07 0.052"/>
      <geometry><box size="0.008 0.008 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.108 0 0.07" rpy="0 -0.08 0"/>
      <geometry><box size="0.035 0.19 0.006"/></geometry>
      <material name="black"/>
    </visual>
    <!-- Headlights, taillights -->
    <visual>
      <origin xyz="0.1155 0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="headlight"/>
    </visual>
    <visual>
      <origin xyz="0.1155 -0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="headlight"/>
    </visual>
    <visual>
      <origin xyz="-0.1155 0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="taillight"/>
    </visual>
    <visual>
      <origin xyz="-0.1155 -0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="taillight"/>
    </visual>
    <!-- Door number roundels -->
    <visual>
      <origin xyz="-0.02 0.0955 0.02"/>
      <geometry><box size="0.032 0.002 0.026"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="-0.02 -0.0955 0.02"/>
      <geometry><box size="0.032 0.002 0.026"/></geometry>
      <material name="white"/>
    </visual>
    <!-- Fake front wheels (visual only; caster carries the weight) -->
    <visual>
      <origin xyz="0.075 0.105 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.075 0.105 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.027"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.075 -0.105 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.075 -0.105 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.027"/></geometry>
      <material name="grey"/>
    </visual>
    <!-- Camera mast, rear deck (see camera_joint) -->
    <visual>
      <origin xyz="-0.10 0 0.0925"/>
      <geometry><box size="0.012 0.012 0.085"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.10 0 0.052"/>
      <geometry><box size="0.03 0.03 0.006"/></geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.22 0.18 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="1.5"/>
      <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.0065" iyz="0" izz="0.0101"/>
    </inertial>
  </link>

  <!-- ===== Drive wheels (rear) ===== -->
  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.027"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.022 0 0"/>
      <geometry><box size="0.012 0.028 0.008"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="6.1e-5" iyz="0" izz="3.6e-5"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="-0.06 0.105 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.027"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.022 0 0"/>
      <geometry><box size="0.012 0.028 0.008"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="6.1e-5" iyz="0" izz="3.6e-5"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="-0.06 -0.105 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===== Front caster (frictionless ball) ===== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1.8e-6" ixy="0" ixz="0" iyy="1.8e-6" iyz="0" izz="1.8e-6"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.08 0 -0.02"/>
  </joint>

  <!-- ===== Camera: Luxonis OAK-D Lite ===== -->
  <!-- Mast top, REAR of the chassis, level, facing forward. The camera is
       fixed (no pan/tilt). Mounting it at the back puts it ~8 in further from
       the start flag tower, which brings the raised flag into the top-left of
       the frame with the robot facing straight ahead in the start box. Level
       (0 deg tilt) is needed for that: tilted down 10-20 deg the flag is out
       of view. The robot's own hood shows in the bottom of the image; mask it
       out in your vision code. (Flag position is an ASSUMPTION until Game
       Manual Appendix F is published; see simulation/README.md.)
       camera_link is the center of the OAK-D Lite body, +x out of the lenses.
       Body 91 x 28 x 17.5 mm, 61 g. Lenses on the front face: left mono,
       color in the middle, right mono, 75 mm stereo baseline.
       Specs: https://docs.luxonis.com/hardware/products/OAK-D%20Lite -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.0175 0.091 0.028"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.0089 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0055" length="0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0.0089 0.0375 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.004" length="0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0.0089 -0.0375 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.004" length="0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <collision>
      <geometry><box size="0.0175 0.091 0.028"/></geometry>
    </collision>
    <inertial>
      <mass value="0.061"/>
      <inertia ixx="4.6e-5" ixy="0" ixz="0" iyy="5.6e-6" iyz="0" izz="4.4e-5"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.10 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ROS optical frame convention: z forward, x right, y down. -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- OAK-D Lite's built-in IMU (Bosch BMI270), inside the camera body.
       imu_link uses the robot convention (x forward, y left, z up). On the
       real camera the chip's axes differ; DepthAI / the ROS driver rotate
       them, so check your driver's frame before reusing sim-tuned code. -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== Gazebo (Harmonic) extensions ===== -->
  <!-- Keep caster_link as its own link. Otherwise the URDF converter merges it
       into base_link and the zero-friction setting can be lost. -->
  <gazebo reference="caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- OAK-D Lite, modeled the way most DepthAI pipelines run it: stereo depth
       aligned to the color camera (setDepthAlign(CAM_A)), so color and depth
       share one image grid, one camera_info and one frame.
         Color, IMX214: 69 x 54 deg FOV (4:3). The real sensor is 13 MP;
           640 x 480 keeps the sim fast. Raise width/height to match your
           pipeline if you need more detail.
         Depth, 2x OV7251 global-shutter mono, 75 mm baseline: minimum depth
           0.20 m with extended disparity (0.40 m without), ideal range to
           12 m. Anything closer than 0.20 m reads as no depth; the color
           image still shows it. -->
  <gazebo reference="camera_link">
    <sensor name="oakd" type="rgbd_camera">
      <pose>0.0089 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.20</near>
            <far>12.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- BMI270 IMU, 200 Hz (DepthAI tops out near 250 Hz on this chip).
       Raw accel + gyro only, like the real BMI270: no orientation.
       Noise from the Bosch datasheet, per axis at 200 Hz:
         gyro  0.007 dps/sqrt(Hz) -> 1.73e-3 rad/s
         accel 160 ug/sqrt(Hz)    -> 0.022 m/s^2
       Bias spread assumes a calibrated sensor (raw zero offsets are larger:
       about +/-0.5 dps and +/-20 mg). Accel includes gravity (+9.81 on z at
       rest), as on the real chip. -->
  <gazebo reference="imu_link">
    <sensor name="oakd_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>camera/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <enable_orientation>false</enable_orientation>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.73e-3</stddev><bias_mean>0</bias_mean><bias_stddev>5e-4</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.73e-3</stddev><bias_mean>0</bias_mean><bias_stddev>5e-4</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.73e-3</stddev><bias_mean>0</bias_mean><bias_stddev>5e-4</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.022</stddev><bias_mean>0</bias_mean><bias_stddev>0.02</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.022</stddev><bias_mean>0</bias_mean><bias_stddev>0.02</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.022</stddev><bias_mean>0</bias_mean><bias_stddev>0.02</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.21</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
