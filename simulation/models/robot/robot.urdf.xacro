<?xml version="1.0"?>
<!--
  SECON27 race robot: stock-car body, rear-wheel drive, front-wheel steering
  (Ackermann, like the real chassis: one servo steers the front wheels),
  Luxonis OAK-D Lite on an adjustable mast.
  Fits the 12 x 12 x 12 in (0.3048 m) start cube.

  Frames: base_link is the center of the body at wheel-axle height
  (x forward, z up). Rear axle at x = -0.06, front axle at x = +0.075.

  The camera mount is set by xacro arguments, which sim.launch.py passes
  through from its launch options (cam_x, cam_y, cam_z, cam_pitch, cam_yaw):
    cam_x      m forward of base_link (body center)   (default -0.10, rear deck)
    cam_y      m left of the centerline                (default 0)
    cam_z      m above the floor, lens center          (default 0.185)
    cam_pitch  deg, positive tilts DOWN                (default 0, level)
    cam_yaw    deg, positive turns LEFT                (default 0, forward)
  See simulation/README.md, "Camera placement".
-->
<robot name="race_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="cam_x" default="-0.10"/>
  <xacro:arg name="cam_y" default="0.0"/>
  <xacro:arg name="cam_z" default="0.185"/>
  <xacro:arg name="cam_pitch" default="0.0"/>
  <xacro:arg name="cam_yaw" default="0.0"/>

  <xacro:property name="wheel_r" value="0.035"/>
  <xacro:property name="rear_x" value="-0.06"/>       <!-- rear (drive) axle -->
  <xacro:property name="front_x" value="0.075"/>      <!-- front (steered) axle -->
  <xacro:property name="track" value="0.21"/>         <!-- wheel centers, left to right -->
  <xacro:property name="kingpin" value="0.18"/>       <!-- steering pivots, inboard of the tires -->

  <!-- ASSUMED until measured on the real robot -->
  <xacro:property name="steer_limit" value="0.5236"/> <!-- 30 deg servo lock, inner wheel -->
  <xacro:property name="max_speed" value="0.8"/>      <!-- m/s -->
  <xacro:property name="max_accel" value="1.5"/>      <!-- m/s^2 -->

  <xacro:property name="cam_x" value="$(arg cam_x)"/>
  <xacro:property name="cam_y" value="$(arg cam_y)"/>
  <xacro:property name="cam_z_base" value="${$(arg cam_z) - wheel_r}"/>
  <xacro:property name="cam_pitch" value="${$(arg cam_pitch) * pi / 180}"/>
  <xacro:property name="cam_yaw" value="${$(arg cam_yaw) * pi / 180}"/>
  <xacro:property name="deck_top" value="0.049"/>     <!-- rear deck, base frame -->

  <!-- ===== Materials ===== -->
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
  <material name="glass"><color rgba="0.1 0.15 0.2 1"/></material>
  <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="headlight"><color rgba="1.0 0.9 0.4 1"/></material>
  <material name="taillight"><color rgba="0.45 0.0 0.0 1"/></material>

  <!-- ===== Chassis ===== -->
  <!-- Stock-car styling: visuals only. -->
  <link name="base_link">
    <!-- Lower body -->
    <visual>
      <origin xyz="0 0 0.0175"/>
      <geometry><box size="0.23 0.19 0.045"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Hood (slopes down toward nose) -->
    <visual>
      <origin xyz="0.072 0 0.045" rpy="0 0.12 0"/>
      <geometry><box size="0.085 0.19 0.01"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Greenhouse, windshield, rear window, roof -->
    <visual>
      <origin xyz="-0.03 0 0.0615"/>
      <geometry><box size="0.09 0.15 0.043"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0.0075 0 0.0675" rpy="0 0.66 0"/>
      <geometry><box size="0.057 0.15 0.006"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="-0.09 0 0.0675" rpy="0 -0.86 0"/>
      <geometry><box size="0.046 0.15 0.006"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 0.086"/>
      <geometry><box size="0.07 0.15 0.006"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Racing stripes (hood, roof) -->
    <visual>
      <origin xyz="0.072 0 0.0505" rpy="0 0.12 0"/>
      <geometry><box size="0.085 0.03 0.002"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 0.0895"/>
      <geometry><box size="0.07 0.03 0.002"/></geometry>
      <material name="white"/>
    </visual>
    <!-- Front splitter, side skirts -->
    <visual>
      <origin xyz="0.12 0 -0.003"/>
      <geometry><box size="0.03 0.2 0.004"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0 0.097 0.002"/>
      <geometry><box size="0.12 0.004 0.012"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.097 0.002"/>
      <geometry><box size="0.12 0.004 0.012"/></geometry>
      <material name="black"/>
    </visual>
    <!-- Rear spoiler (low, deck mounted) -->
    <visual>
      <origin xyz="-0.108 0.07 0.052"/>
      <geometry><box size="0.008 0.008 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.108 -0.07 0.052"/>
      <geometry><box size="0.008 0.008 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.108 0 0.07" rpy="0 -0.08 0"/>
      <geometry><box size="0.035 0.19 0.006"/></geometry>
      <material name="black"/>
    </visual>
    <!-- Headlights, taillights -->
    <visual>
      <origin xyz="0.1155 0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="headlight"/>
    </visual>
    <visual>
      <origin xyz="0.1155 -0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="headlight"/>
    </visual>
    <visual>
      <origin xyz="-0.1155 0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="taillight"/>
    </visual>
    <visual>
      <origin xyz="-0.1155 -0.065 0.028"/>
      <geometry><box size="0.004 0.035 0.012"/></geometry>
      <material name="taillight"/>
    </visual>
    <!-- Door number roundels -->
    <visual>
      <origin xyz="-0.02 0.0955 0.02"/>
      <geometry><box size="0.032 0.002 0.026"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="-0.02 -0.0955 0.02"/>
      <geometry><box size="0.032 0.002 0.026"/></geometry>
      <material name="white"/>
    </visual>
    <!-- Camera mast: from the rear deck up to the camera -->
    <xacro:if value="${cam_z_base - 0.014 > deck_top}">
      <visual>
        <origin xyz="${cam_x} ${cam_y} ${(deck_top + cam_z_base - 0.014) / 2}"/>
        <geometry><box size="0.012 0.012 ${cam_z_base - 0.014 - deck_top}"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="${cam_x} ${cam_y} ${deck_top + 0.003}"/>
        <geometry><box size="0.03 0.03 0.006"/></geometry>
        <material name="black"/>
      </visual>
    </xacro:if>

    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.22 0.18 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="1.5"/>
      <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.0065" iyz="0" izz="0.0101"/>
    </inertial>
  </link>

  <!-- ===== Wheels (old look: black tire, grey hub, white marker) ===== -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.035" length="0.025"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.02" length="0.027"/></geometry>
        <material name="grey"/>
      </visual>
      <visual>
        <origin xyz="0.022 0 0"/>
        <geometry><box size="0.012 0.028 0.008"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="3.6e-5" ixy="0" ixz="0" iyy="6.1e-5" iyz="0" izz="3.6e-5"/>
      </inertial>
    </link>
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <!-- Rear: driven -->
  <xacro:macro name="rear_wheel" params="side s">
    <xacro:wheel_link name="${side}_wheel_link"/>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${rear_x} ${s * track / 2} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:rear_wheel side="left" s="1"/>
  <xacro:rear_wheel side="right" s="-1"/>

  <!-- Front: steered by the servo (one steering joint per side, as in an
       Ackermann linkage), free rolling. Same spot as the old model's
       front wheels. -->
  <xacro:macro name="front_wheel" params="side s">
    <link name="front_${side}_knuckle">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="front_${side}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${front_x} ${s * kingpin / 2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steer_limit}" upper="${steer_limit}" effort="5" velocity="8"/>
    </joint>
    <xacro:wheel_link name="front_${side}_wheel_link"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_knuckle"/>
      <child link="front_${side}_wheel_link"/>
      <origin xyz="0 ${s * (track - kingpin) / 2} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:front_wheel side="left" s="1"/>
  <xacro:front_wheel side="right" s="-1"/>

  <!-- ===== Camera: Luxonis OAK-D Lite ===== -->
  <!-- camera_link is the center of the OAK-D Lite body, +x out of the lenses.
       Body 91 x 28 x 17.5 mm, 61 g. Lenses on the front face: left mono,
       color in the middle, right mono, 75 mm stereo baseline.
       Specs: https://docs.luxonis.com/hardware/products/OAK-D%20Lite -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.0175 0.091 0.028"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.0089 0 0" rpy="0 ${pi / 2} 0"/>
      <geometry><cylinder radius="0.0055" length="0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0.0089 0.0375 0" rpy="0 ${pi / 2} 0"/>
      <geometry><cylinder radius="0.004" length="0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0.0089 -0.0375 0" rpy="0 ${pi / 2} 0"/>
      <geometry><cylinder radius="0.004" length="0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <collision>
      <geometry><box size="0.0175 0.091 0.028"/></geometry>
    </collision>
    <inertial>
      <mass value="0.061"/>
      <inertia ixx="4.6e-5" ixy="0" ixz="0" iyy="5.6e-6" iyz="0" izz="4.4e-5"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} ${cam_y} ${cam_z_base}" rpy="0 ${cam_pitch} ${cam_yaw}"/>
  </joint>

  <!-- ROS optical frame convention: z forward, x right, y down. -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

  <!-- OAK-D Lite's built-in IMU (Bosch BMI270), inside the camera body.
       imu_link uses the robot convention (x forward, y left, z up). On the
       real camera the chip's axes differ; DepthAI / the ROS driver rotate
       them, so check your driver's frame before reusing sim-tuned code. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ===== Gazebo (Harmonic) ===== -->
  <!-- OAK-D Lite, modeled the way most DepthAI pipelines run it: stereo depth
       aligned to the color camera (setDepthAlign(CAM_A)), so color and depth
       share one image grid, one camera_info and one frame.
         Color, IMX214: 69 x 54 deg FOV (4:3). The real sensor is 13 MP;
           640 x 480 keeps the sim fast.
         Depth, 2x OV7251, 75 mm baseline: minimum depth 0.20 m with
           extended disparity (0.40 m without), ideal range to 12 m.
       The ROS point cloud /camera/points is built from this depth by
       depth_image_proc (see sim.launch.py), not taken from Gazebo. -->
  <gazebo reference="camera_link">
    <sensor name="oakd" type="rgbd_camera">
      <pose>0.0089 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.20</near>
            <far>12.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- BMI270 IMU, 200 Hz. Raw accel + gyro only (no orientation), datasheet
       noise per axis at 200 Hz: gyro 0.007 dps/sqrt(Hz) -> 1.73e-3 rad/s,
       accel 160 ug/sqrt(Hz) -> 0.022 m/s^2. Bias spread assumes a
       calibrated sensor. Accel includes gravity (+9.81 on z at rest). -->
  <gazebo reference="imu_link">
    <sensor name="oakd_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>camera/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <enable_orientation>false</enable_orientation>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.73e-3</stddev><bias_mean>0</bias_mean><bias_stddev>5e-4</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.73e-3</stddev><bias_mean>0</bias_mean><bias_stddev>5e-4</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.73e-3</stddev><bias_mean>0</bias_mean><bias_stddev>5e-4</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.022</stddev><bias_mean>0</bias_mean><bias_stddev>0.02</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.022</stddev><bias_mean>0</bias_mean><bias_stddev>0.02</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.022</stddev><bias_mean>0</bias_mean><bias_stddev>0.02</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Rear-wheel drive + servo steering. cmd_vel keeps its meaning:
       linear.x = forward speed (m/s), angular.z = yaw rate (rad/s); the
       plugin turns the yaw rate into a steering angle, clamped to the servo
       limit. A car can't turn in place: angular.z with linear.x = 0 does
       nothing. -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>${kingpin}</kingpin_width>
      <steering_limit>${steer_limit}</steering_limit>
      <wheel_base>${front_x - rear_x}</wheel_base>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <min_velocity>${-max_speed}</min_velocity>
      <max_velocity>${max_speed}</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>${max_accel}</max_acceleration>
      <steer_p_gain>10.0</steer_p_gain>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
